// Assignment 2: conditions
let score = 85;
let grade = "";
// finding the grade using switch
switch (Math.floor(score / 10)) {
  case 10:
  case 9:
    grade = "A";
    break;
  case 8:
    grade = "B";
    break;
  case 7:
    grade = "C";
    break;
  case 6:
    grade = "D";
    break;
  default:
    grade = "F";
}

// check pass or fail
let status = "";
if (score >= 40) {
  status = "Passed";
} else {
  status = "Failed";
}
// same thing using ternary operator
let result = score >= 40 ? "Passed" : "Failed";

console.log("Score: " + score);
console.log("Grade: " + grade);
console.log("Status: " + result);
